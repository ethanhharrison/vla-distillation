.venv/
datasets/
images/
outputs/
/datasets
/outputs
/future
uv.lock
.env
*__pycache__/

# explore/dreamzero: keep upstream clone, venv, weights, and results out of git
/explorations/dreamzero/repo/
/explorations/dreamzero/.venv/
/explorations/dreamzero/results/

# explore/cosmos3: same — venv, generated videos/actions, run logs
/explorations/cosmos3/.venv/
/explorations/cosmos3/results/
/explorations/cosmos3/*.log

# explore/image_edit: generated subgoals + reports (runs on the main venv)
/explorations/image_edit/results/
/explorations/image_edit/*.log

# explore/wan: generated clips + run logs (runs on the cosmos3 venv).
# `results` is a SYMLINK to /raid — the home fs is at 100%. Both forms are
# needed: a trailing-slash pattern does not match a symlink.
/explorations/wan/results
/explorations/wan/results/
/explorations/wan/*.log
